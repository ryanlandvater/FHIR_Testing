workspace(name = "fastfhir_benchmarking")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
load("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

http_archive(
    name = "nlohmann_json",
    urls = ["https://github.com/nlohmann/json/releases/download/v3.11.3/json.tar.xz"],
    sha256 = "d6c65aca6b1ed68e7a182f4757257b107ae403032760ed6ef121c9d55e81757d",
    strip_prefix = "json",
    build_file_content = """
cc_library(
    name = "json",
    hdrs = glob(["single_include/**/*.hpp", "single_include/**/*.h"]),
    includes = ["single_include"],
    visibility = ["//visibility:public"],
)
""",
)

# macOS libpq for //bench:bench_harness_pg. Homebrew keeps libpq keg-only, so
# the prefix is not on the default include/lib path. Override with
# LIBPQ_MACOS_PATH if yours lives elsewhere.
#
# This exists as a repository rather than a bare -I/-L pair because Bazel
# rejects absolute include paths outside the execution root under sandboxed
# compilation -- which is what broke the old :bench_harness target.
new_local_repository(
    name = "libpq_macos",
    path = "/opt/homebrew/opt/libpq",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "libpq",
    hdrs = glob(["include/*.h"]),
    includes = ["include"],
    linkopts = ["-lpq"],
)
""",
)

new_local_repository(
    name = "libpq_win",
    path = "C:/PROGRA~1/POSTGR~1/16",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "libpq",
    hdrs = glob(["include/*.h"]),
    includes = ["include"],
    linkopts = ["C:/PROGRA~1/POSTGR~1/16/lib/libpq.lib"],
)
""",
)

