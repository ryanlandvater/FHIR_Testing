# macOS
.DS_Store

# Bazel build artifacts (no trailing slash: Bazel creates these as symlinks,
# and a trailing-slash pattern matches directories only)
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-fastfhir-benchmark
MODULE.bazel.lock

# Python/Jupyter
.ipynb_checkpoints/
__pycache__/
*.pyc
.env
.venv/
notebooks/analysis_exports/
notebooks/benchmark_outputs/
notebooks/.bench_tmp/

# Arbiter
.arbiter/

# Benchmark result artifacts should not be committed at repo root
BENCHMARK_RESULTS.md
BENCHMARK_SUMMARY.txt

# Build outputs
build/
build-*/
out/
cmake-build-*/
dist/
bin/
obj/
local/
.external/
xcode/
local/
docs/

# Artifacts and runtime data
artifacts/*
!artifacts/.keep
datasets/*
!datasets/.keep
logs/
profiles/
metrics/
notebooks/results/
*.log
*.sqlite
*.db


# Terraform local state
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Docker local overrides
docker-compose.override.yml

# Memoized corpus digest (IN-0). Derived from datasets/synthea, cheap to
# recompute, and machine-specific -- the corpus itself is not checked in.
datasets/.corpus_sha256.cache

# Development benchmark runs and rendered figures. Regenerated by every sweep
# (harness stdout + scripts/plot_benchmarks.py) -- not source of truth.
results/

# script(1) typescript log from an interactive session
started

# Corruption-probe inputs (regenerated by --dump-artifacts)
artifacts/
